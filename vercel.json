{
  "ignoreCommand": "git rev-parse --verify -q HEAD^ >/dev/null && git diff --quiet HEAD^ HEAD -- . ':(exclude)docs/CODEMAP.md'",
  "functions": {
    "api/netease.js": {
      "includeFiles": "node_modules/@neteasecloudmusicapienhanced/api/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/netease/:path*",
      "destination": "/api/netease?path=/:path*"
    },
    {
      "source": "/api/qq/:path*",
      "destination": "/api/qq?path=/:path*"
    }
  ]
}
